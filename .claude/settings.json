{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt -l *)",
      "Bash(make check)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(go get *)",
      "Bash(docker compose down *)",
      "Bash(make reset)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-migraciones.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/formatear.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pruebas-al-terminar.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
